# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user IDs allowed to use admin commands (/add, /edit, etc.)
ADMIN_USER_IDS=

# Path to SQLite DB (default: data/bot.db)
DB_PATH=data/bot.db

# Directory for rendered PNG images (default: data/images)
IMAGES_DIR=data/images

# Source site (do not change unless you know what you're doing)
SOURCE_BASE_URL=https://amkbook.net
SOURCE_BOOK_ID=1
